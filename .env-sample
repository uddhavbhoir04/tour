# ---------------- Server ----------------
PORT=8000
NODE_ENV_CUSTOM=development   # development | production
SERVER_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# ---------------- Database ----------------
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tour?retryWrites=true&w=majority

# ---------------- Auth ----------------
JWT_SECRET=change-me

# ---------------- Gemini ----------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_USER_LIMIT=20
AI_RATE_LIMIT_PER_MINUTE=6
AI_MAX_INPUT_CHARS=4000
AI_CONTEXT_MESSAGES=10
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65
RAG_KEYWORD_MIN_COVERAGE=0.5
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=roamingbirds_knowledge

# ---------------- Email (Resend) ----------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=
NOTIFICATION_EMAIL_ENABLED=true
TREK_REMINDER_HOURS=24

# ---------------- Redis (Upstash) ----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API cache TTL (3 days)
CACHE_TTL_SECONDS=259200
